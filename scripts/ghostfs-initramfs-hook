#!/usr/bin/env bash
# /etc/initramfs-tools/hooks/ghostfs
# Initramfs hook — bundles ghostfs binary + libfuse (+ optional TPM/plymouth
# support) into the initramfs so the root filesystem can be mounted by
# ghostfs before the init system pivots root.
#
# Install:
#   cp ghostfs-initramfs-hook /etc/initramfs-tools/hooks/ghostfs
#   chmod +x /etc/initramfs-tools/hooks/ghostfs
#   update-initramfs -u
#
# This hook runs at initramfs BUILD time (not at boot time).

PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac

. /usr/share/initramfs-tools/hook-functions

# ── Copy the ghostfs binary ──────────────────────────────────────────────────
GHOSTFS_BIN="$(command -v ghostfs 2>/dev/null || echo /usr/local/bin/ghostfs)"
if [[ ! -x "$GHOSTFS_BIN" ]]; then
    echo "ghostfs initramfs hook: binary not found at $GHOSTFS_BIN — skipping" >&2
    exit 0
fi

copy_exec "$GHOSTFS_BIN" /usr/local/bin/ghostfs

# ── Copy FUSE libraries ──────────────────────────────────────────────────────
for lib in libfuse3.so.3 libfuse.so.2; do
    found=$(ldconfig -p 2>/dev/null | awk -v l="$lib" '$1==l{print $NF; exit}')
    [[ -n "$found" ]] && copy_exec "$found"
done

# ── Copy TPM 2.0 userspace libraries (only if the 'tpm' feature was built in
#    and /dev/tpm* is present at build time — best-effort, non-fatal). ───────
if [[ -e /dev/tpmrm0 || -e /dev/tpm0 ]]; then
    for lib in libtss2-esys.so.0 libtss2-mu.so.0 libtss2-sys.so.1 libtss2-tctildr.so.0; do
        found=$(ldconfig -p 2>/dev/null | awk -v l="$lib" '$1==l{print $NF; exit}')
        [[ -n "$found" ]] && copy_exec "$found"
    done
    echo "ghostfs initramfs hook: TPM device present — bundled tss2 libraries"
fi

# ── Copy plymouth (if installed) so the passphrase prompt can use the splash
#    screen instead of a raw console read — purely cosmetic, mount script
#    falls back to plain `read -s` if plymouth isn't available. ─────────────
if command -v plymouth >/dev/null 2>&1; then
    copy_exec "$(command -v plymouth)" /bin/plymouth
fi

# ── Copy the plaintext key file if configured (least-preferred unlock path;
#    prefer GHOSTFS_SEALED_KEY_FILE / TPM below). ────────────────────────────
KEY_FILE="${GHOSTFS_KEY_FILE:-/etc/ghostfs/key.hex}"
if [[ -f "$KEY_FILE" ]]; then
    mkdir -p "${DESTDIR}/etc/ghostfs"
    cp "$KEY_FILE" "${DESTDIR}/etc/ghostfs/key.hex"
    chmod 600 "${DESTDIR}/etc/ghostfs/key.hex"
    echo "ghostfs initramfs hook: bundled plaintext key file"
fi

# ── Copy the TPM-sealed key blob if configured — this is the recommended
#    unlock path for early-boot: the blob is useless without the matching
#    TPM + PCR state, so bundling it into the initramfs is safe (unlike the
#    plaintext key file above, which grants full access to anyone who reads
#    the initramfs image). Generate with:
#        ghostfs tpm-seal-key --key-file key.hex --output sealed.bin --pcr 7
SEALED_KEY_FILE="${GHOSTFS_SEALED_KEY_FILE:-/etc/ghostfs/sealed.bin}"
if [[ -f "$SEALED_KEY_FILE" ]]; then
    mkdir -p "${DESTDIR}/etc/ghostfs"
    cp "$SEALED_KEY_FILE" "${DESTDIR}/etc/ghostfs/sealed.bin"
    chmod 600 "${DESTDIR}/etc/ghostfs/sealed.bin"
    echo "ghostfs initramfs hook: bundled TPM-sealed key blob"
fi

# ── Ensure the fuse kernel module is included ─────────────────────────────────
manual_add_modules fuse
force_load fuse

# ── Ensure the tpm kernel modules are included (harmless if unused) ──────────
manual_add_modules tpm tpm_tis tpm_crb 2>/dev/null || true
