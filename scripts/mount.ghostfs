#!/usr/bin/env bash
# /sbin/mount.ghostfs
#
# Standard Linux `mount` helper — makes `mount -t ghostfs <device> <mnt>`
# and /etc/fstab entries with `ghostfs` as the fs type work exactly like
# they would for a kernel-native filesystem, even though GhostFS is a FUSE
# filesystem under the hood (`mount(8)` looks for /sbin/mount.<type> and
# execs it with a conventional argument shape when the type isn't built
# into the kernel).
#
# Install: copy to /sbin/mount.ghostfs, chmod +x. Done automatically by the
# .deb package (see packaging/deb).
#
# Called by mount(8) as:
#   mount.ghostfs <device> <mountpoint> [-o <options>] [-n] [-v] [-s] [-f]
#
# fstab options honoured (comma-separated, standard `-o` syntax):
#   key-file=<path>         — key file for cybersec (encrypted) volumes
#   passphrase-file=<path>  — file containing the passphrase (0600 perms!);
#                              NOT the same as a raw key file — this goes
#                              through the Argon2id KDF like an interactive
#                              passphrase would.
#   compression=<algo>      — zstd (default) | lz4 | zlib | none
#   rate-limit-mb=<n>       — per-uid I/O throttle (default 100)
#   noatime / atime         — standard semantics
#   allow_other             — standard FUSE semantics
#   ro                      — NOT currently supported by ghostfs (warns, still RW)
#
# Example /etc/fstab line:
#   /dev/sdb1  /mnt/vault  ghostfs  noatime,compression=zstd,key-file=/etc/ghostfs/vault.hex  0  0

set -euo pipefail

DEVICE="${1:?device required}"
MOUNTPOINT="${2:?mountpoint required}"
shift 2

OPTS=""
VERBOSE=0
FAKE=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -o) OPTS="$2"; shift 2 ;;
        -v) VERBOSE=1; shift ;;
        -n) shift ;;   # don't update mtab — mtab is a symlink to /proc/mounts on modern systems anyway
        -s) shift ;;   # sloppy — ignore unknown options rather than failing; we already do this
        -f) FAKE=1; shift ;;
        *)  shift ;;
    esac
done

GHOSTFS_BIN="$(command -v ghostfs || echo /usr/local/bin/ghostfs)"
ARGS=(mount --device "$DEVICE" --mountpoint "$MOUNTPOINT")

IFS=',' read -ra OPT_ARR <<< "$OPTS"
COMPRESSION="zstd"
RATE_MB="100"
for opt in "${OPT_ARR[@]}"; do
    case "$opt" in
        key-file=*)        ARGS+=(--key-file "${opt#key-file=}") ;;
        passphrase-file=*) pass="$(cat "${opt#passphrase-file=}")"; ARGS+=(--passphrase "$pass") ;;
        compression=*)     COMPRESSION="${opt#compression=}" ;;
        rate-limit-mb=*)   RATE_MB="${opt#rate-limit-mb=}" ;;
        noatime)           ARGS+=(--noatime) ;;
        atime)             : ;;
        allow_other)       ARGS+=(--allow-other) ;;
        ro)                echo "mount.ghostfs: warning: read-only mounts are not yet supported, mounting RW" >&2 ;;
        defaults|rw|user|users|auto|noauto|nofail|_netdev) : ;; # standard fstab noise, ignore
        "" ) : ;;
        *)  [[ "$VERBOSE" == "1" ]] && echo "mount.ghostfs: ignoring unknown option '$opt'" >&2 ;;
    esac
done
ARGS+=(--compression "$COMPRESSION" --rate-limit-mb "$RATE_MB")

if [[ "$FAKE" == "1" ]]; then
    echo "mount.ghostfs: (fake) ${GHOSTFS_BIN} ${ARGS[*]}"
    exit 0
fi

[[ "$VERBOSE" == "1" ]] && echo "mount.ghostfs: ${GHOSTFS_BIN} ${ARGS[*]}"

mkdir -p "$MOUNTPOINT"
exec "$GHOSTFS_BIN" "${ARGS[@]}"
