[package]
-> name        => GhostFS
-> version     => 0.5.0
-> using       => 0.4
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> description => GhostFS (edycja HackerScript) - system plikow HackerOS.

[lib]
-> name => ghostfs
-> path => source-code/fs/lib.hcs

[bin]
-> name => ghostfs
-> path => source-code/main.hcs

[dependencies]
-> std
--> io => "*"
--> fs => "*"

[features]
-> default  => ["cybersec", "zstd", "lz4"]
-> cybersec => []
-> zstd     => []
-> lz4      => []
-> tpm      => []
-> grpc-tls => []
-> canary-https => []
