#!/bin/sh
# postrm for ghostfs
#
# NOTE: the Calamares config revert used to live here, but that's wrong —
# see DEBIAN/prerm for why (dpkg has already deleted this package's own
# files, including calamares-patch.py, by the time `postrm remove` runs).
# This script now only handles cleanup that genuinely belongs post-removal:
# refreshing the initramfs (a SYSTEM tool, not one of our own files, so
# it's fine to still be available here) and, on a full purge, clearing our
# non-conffile state directory.
set -e

case "$1" in
  purge)
    rm -rf /etc/ghostfs 2>/dev/null || true
    if command -v update-initramfs >/dev/null 2>&1; then
        update-initramfs -u || true
    fi
    ;;

  remove)
    if command -v update-initramfs >/dev/null 2>&1; then
        update-initramfs -u || true
    fi
    ;;

  upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;

  *)
    echo "postrm called with unknown argument \`$1'" >&2
    exit 1
    ;;
esac

exit 0
