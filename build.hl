#!/usr/bin/hl
using <gen 2>

# <main/colors>

% INSTALL_DIR: str = /usr/local/bin
% VIRUS: str = virus

;; GhostFS (edycja HackerScript) — TYLKO tryb cybersec. W odroznieniu od
;; wersji Rust (ktora miala tez tryb "normal" do codziennego uzytku), ten
;; build.hl buduje wylacznie wariant cybersecurity — nie ma tu i nie bedzie
;; trybu "normal". Kompiluje przez `virus`/`hackerc` (HackerScript -> Rust),
;; nie bezposrednio przez `cargo`.

;; ── Helper ────────────────────────────────────────────────

: info def
    ::cyan ▶ @msg
done

: ok def
    ::green ✓ @msg
done

;; ── Targets ───────────────────────────────────────────────

: cybersec def
    -- info
    \~> Building GhostFS-HackerScript [CYBERSEC MODE — jedyny tryb]...
    > @VIRUS build --release --features cybersec,zstd,lz4
    -- ok
    \~> Binary: target/release/ghostfs-cybersec
done

: cybersec-debug def
    > @VIRUS build --features cybersec,zstd,lz4
done

: test def
    -- info
    \~> Testing Cybersec mode (jedyny tryb w tej edycji)...
    > @VIRUS test --features cybersec,zstd,lz4
done

: install def
    -- cybersec
    ^> install -m 755 target/release/ghostfs-cybersec @INSTALL_DIR/ghostfs-cybersec
    -- ok
    \~> Installed to @INSTALL_DIR/ghostfs-cybersec
done

: fmt def
    > @VIRUS fmt --all
done

: check def
    > @VIRUS check --features cybersec,zstd,lz4
    > @VIRUS lint --features cybersec,zstd,lz4
done

: clean def
    > @VIRUS clean
done

: all def
    -- cybersec
done

: help def
    \~> GhostFS-HackerScript build.hl (Hacker Lang)
    \~>
    \~> Ta edycja jest WYLACZNIE do cyberbezpieczenstwa — nie ma trybu
    \~> "normal" (jest w oryginalnej wersji Rust GhostFS).
    \~>
    \~> Available targets:
    \~>   cybersec         — build Cybersec mode (release, jedyny tryb)
    \~>   cybersec-debug   — build Cybersec mode (debug)
    \~>   test             — run tests (cybersec)
    \~>   install          — install do /usr/local/bin
    \~>   fmt              — virus fmt --all
    \~>   check            — virus check + lint
    \~>   clean            — virus clean
    \~>   all              — same as cybersec
    \~>   help             — this message
done

;; ── Dispatcher ────────────────────────────────────────────

% target: str = all

? @argc > 0
    % target = @arg0
done

? switch @target
| cybersec
    -- cybersec
| cybersec-debug
    -- cybersec-debug
| test
    -- test
| install
    -- install
| fmt
    -- fmt
| check
    -- check
| clean
    -- clean
| all
    -- all
| help
    -- help
| *
    ::red Unknown target: @target
    -- help
done
